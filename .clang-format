# ============================================================================
#  代码格式化标准 (clang-format)
#
#  用法（装了 clang-format 的机器上）：
#      clang-format -i <文件>
#      git ls-files "firmware/App/**/*.c" | xargs clang-format -i
#
#  ★ 作用范围：只格式化"我们自己的 / 我们手改过的文件"（见
#    docs/design_firmware/编码规范.md 第一节）。厂商与第三方目录一律保持原样：
#        Drivers/FWLIB、Drivers/CMSIS、Middlewares/FreeRTOS、
#        App/Sensor/DMP、App/Comms/DataScope、User/stm32f4xx*
#
#  ★★ 定位（2026-10-13 决定，决策 55）：**参考配置，当前不强制执行**。
#     实际执行的格式规范见 docs/design_firmware/编码规范.md §五；
#     本文件只作为"将来若要统一排版"的起点，**不要**据此对既有源码跑全量格式化：
#       ① 会把真实逻辑改动淹没在格式 diff 里（实测数百处替换点）；
#       ② 控制代码刚调好、答辩期不适合大动。
#     若将来要执行：单独一个提交 + 用 tools/fw_prep/audit_refactor.py 证明"仅排版变化"。
#
#  ★ 本文件的键名已按 **clang-format 23.1.3** 校验过（`--dump-config` 对照）：
#     · 20.x 起键名有变更（如 `EndOfLine` → `LineEnding`），换版本时请重跑一次校验。
#     · 校验命令：clang-format --style=file --lines=1:1 <某个.c> 2>&1 | grep error
# ============================================================================
---
Language: Cpp
BasedOnStyle: LLVM

# 缩进：硬件代码惯例用制表符，显示宽度 4（本项目既有代码即如此）
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 8

# 大括号：函数与控制语句另起一行（Allman）
# ★ 20.x 起 `BreakBeforeBraces: Allman` 不再等于"函数另起一行"，
#   必须用 Custom + BraceWrapping 精确声明（否则函数会被改成 `f() {`，diff 直接翻倍）。
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Always
  # ★ 类型定义**不**拆行：本项目大量用 `typedef struct { … } X;` 与
  #   `union { float f; uint32_t u; } cvt;` 这类紧凑写法，
  #   设 true 会把它们拆成多行（实测 protocol.c 一次多出 400+ 行差异）。
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  AfterClass: false
  AfterNamespace: false
  AfterExternBlock: false
  BeforeElse: false
  BeforeCatch: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# ★ 允许 `case X: return v;` 单行：本项目参数表/分派表刻意写成单行对齐的表格，
#   设 false 会把它们全部拆成 3 行（实测 param_pack.c 一次多出 130 行差异）。
AllowShortCaseLabelsOnASingleLine: true

# 函数调用的括号前不留空格（`f(a, b)`）；`if (`/`while (` 这类控制语句前留一个空格。
# ★ 本项目厂商风格是全局留空格（`f (a)`），这里**刻意收敛到主流写法**。
SpaceBeforeParens: ControlStatements

# 行宽：**不强制折行**（0 = 关闭自动换行）。
#
# ★ 为什么是 0 而不是 110：本项目的长行大多是"注释里的推导/依据"和表格化对齐，
#   按列宽重排会把它们整体打散 —— 实测协议/任务层三个文件在 110 列下产生
#   **2048 行** diff，其中 100% 是折行；把上限设为 0 后这三个文件的 diff **归零**。
#   所以"排版统一"的落点是：缩进、大括号、空格、空行、行尾 —— 这些规则**零 diff 通过**；
#   而"行太长要不要折"留给作者（新代码请自行控制在 110 列内）。
ColumnLimit: 0

# 指针/引用贴变量名（uint8_t *p）
PointerAlignment: Right
DerivePointerAlignment: false

# 不改 include 顺序：本项目刻意按"系统头 → RTOS → 自研模块"分组并写注释
SortIncludes: false

# switch 的 case 缩进到 switch 内
IndentCaseLabels: true

# 空行治理
MaxEmptyLinesToKeep: 1

# 不强制连续赋值/声明的列对齐（本项目大量手工表格化对齐，交给作者）
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
# ★ 尾随注释**不**重排：作者是按"Tab 显示宽度 8"手工对到同一列的，
#   而 clang-format 按 TabWidth 折算，一改反而错位（实测会把对齐打散）。
AlignTrailingComments: false
# ★ 注释内容不重排：本项目注释是"为什么这么写"的长句 + 表格化排版，
#   重排会打乱可读性（也让 diff 里混入大量注释行）。
ReflowComments: false

# 行尾与文件结尾（★ 20.x 起键名是 LineEnding，不是 EndOfLine）
LineEnding: LF
InsertNewlineAtEOF: true
